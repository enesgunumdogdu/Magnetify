          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Stage Manager aktív. A bal szélső illesztési zóna automatikusan igazodik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stage Manager aktif. Zona snap tepi kiri disesuaikan secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stage Manager è attivo. La zona di aggancio del bordo sinistro viene regolata automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
