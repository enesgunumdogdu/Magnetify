    "settings.general.sensitivity.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة التي يجب سحب النافذة ضمنها من حافة الشاشة لتفعيل الانجذاب"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com de prop de la vora de la pantalla cal arrossegar una finestra perquè s’activi l’encaix"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak blízko k okraji obrazovky musí být okno přetaženo, aby se spustilo přichycení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor tæt på skærmkanten et vindue skal trækkes, for at fastgøring aktiveres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie nah ein Fenster an den Bildschirmrand gezogen werden muss, damit das Einrasten ausgelöst wird"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο κοντά στην άκρη της οθόνης πρέπει να συρθεί ένα παράθυρο για να ενεργοποιηθεί η προσκόλληση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How close to the screen edge a window must be dragged to trigger snapping"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué tan cerca del borde de la pantalla hay que arrastrar una ventana para activar el ajuste"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka lähelle näytön reunaa ikkuna on vedettävä, jotta kiinnitys käynnistyy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quelle distance du bord de l’écran une fenêtre doit être glissée pour déclencher l’ancrage"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה קרוב לקצה המסך יש לגרור חלון כדי להפעיל את ההצמדה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्नैपिंग सक्रिय करने के लिए विंडो को स्क्रीन किनारे के कितने पास खींचना ज़रूरी है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko blizu rubu zaslona prozor mora biti povučen da bi se aktiviralo prianjanje"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen közel kell az ablakot a képernyő széléhez húzni, hogy az illesztés aktiválódjon"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa dekat jendela harus diseret ke tepi layar untuk memicu snap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto vicino al bordo dello schermo deve essere trascinata una finestra per attivare l’aggancio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スナップを発動するために、ウインドウを画面端にどれだけ近づけるか"
