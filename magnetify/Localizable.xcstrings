    "onboarding.welcome.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظّم نوافذك بسهولة باستخدام مناطق المحاذاة واختصارات لوحة المفاتيح والمزيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organitzeu les finestres sense esforç amb zones d'ancoratge, dreceres de teclat i més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizujte okna snadno pomocí oblastí přichycení, klávesových zkratek a dalších."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiser dine vinduer ubesværet med fastgørelseszoner, tastaturgenveje og mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnen Sie Ihre Fenster mühelos mit Einrastzonen, Tastaturkurzbefehlen und mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οργανώστε τα παράθυρά σας εύκολα με ζώνες κουμπώματος, συντομεύσεις πληκτρολογίου και πολλά ακόμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize your windows with drag, keyboard shortcuts, or menu bar — all for a one-time purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza tus ventanas fácilmente con zonas de ajuste, atajos de teclado y más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä ikkunasi vaivattomasti kohdistusalueilla, pikanäppäimillä ja muilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisez vos fenêtres sans effort grâce aux zones d'ancrage, raccourcis clavier et plus encore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארגן את החלונות שלך ללא מאמץ עם אזורי הצמדה, קיצורי מקלדת ועוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्नैप ज़ोन, कीबोर्ड शॉर्टकट और अन्य सुविधाओं के साथ अपनी विंडो को आसानी से व्यवस्थित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizirajte prozore bez napora pomoću zona priljepljivanja, tipkovničkih prečaca i još mnogo toga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendezze el ablakait könnyedén illesztési zónákkal, billentyűparancsokkal és egyebekkel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur jendela Anda dengan mudah menggunakan zona snap, pintasan keyboard, dan lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizza le tue finestre senza sforzo con zone di aggancio, scorciatoie da tastiera e altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スナップゾーン、キーボードショートカットなどでウインドウを簡単に整理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스냅 영역, 키보드 단축키 등으로 창을 손쉽게 정리하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susun tetingkap anda dengan mudah menggunakan zon lekat, pintasan papan kekunci dan banyak lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiser vinduene dine enkelt med festingssoner, tastatursnarveier og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiseer uw vensters moeiteloos met snapzones, sneltoetsen en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizuj okna z łatwością dzięki strefom przyciągania, skrótom klawiaturowym i nie tylko."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize suas janelas sem esforço com zonas de encaixe, atalhos de teclado e mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizați-vă ferestrele fără efort cu zone de fixare, comenzi rapide și multe altele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Организуйте окна легко с помощью зон привязки, сочетаний клавиш и других возможностей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizujte okná bez námahy pomocou oblastí prichytenia, klávesových skratiek a ďalších funkcií."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisera dina fönster enkelt med fästzoner, tangentbordsgenvägar och mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดระเบียบหน้าต่างของคุณอย่างง่ายดายด้วยโซนสแนป ปุ่มลัด และอื่นๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapışma alanları, klavye kısayolları ve daha fazlasıyla pencerelerinizi zahmetsizce düzenleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Організовуйте вікна без зусиль за допомогою зон прив'язки, швидких клавіш та іншого."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp xếp cửa sổ dễ dàng bằng vùng ghim, phím tắt và nhiều tính năng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过贴靠区域、键盘快捷键等功能轻松整理窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過貼靠區域、鍵盤快捷鍵等功能輕鬆整理視窗。"
          }
        }
      }
    },
