    "settings.general.stageManager" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدير المسرح نشط. يتم ضبط منطقة المحاذاة على الحافة اليسرى تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
