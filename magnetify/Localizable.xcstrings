          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stage Manager ist aktiv. Der linke Einrastbereich wird automatisch angepasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Stage Manager είναι ενεργός. Η ζώνη κουμπώματος στο αριστερό άκρο ρυθμίζεται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
