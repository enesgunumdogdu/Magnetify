    "onboarding.accessibility.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Magnetify إلى إذن الوصول لإدارة نوافذك. يسمح هذا الإذن للتطبيق بنقل النوافذ وتغيير حجمها نيابةً عنك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify necessita accés d'accessibilitat per gestionar les finestres. Aquest permís permet a l'app moure i redimensionar finestres en el vostre nom."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify potřebuje oprávnění přístupnosti ke správě vašich oken. Toto oprávnění umožňuje aplikaci přesouvat a měnit velikost oken za vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify har brug for tilgængelighed for at administrere dine vinduer. Denne tilladelse gør det muligt for appen at flytte og ændre størrelse på vinduer på dine vegne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify benötigt Zugriff auf die Bedienungshilfen, um Ihre Fenster zu verwalten. Diese Berechtigung ermöglicht es der App, Fenster in Ihrem Auftrag zu verschieben und ihre Größe zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Magnetify χρειάζεται πρόσβαση στην προσβασιμότητα για τη διαχείριση των παραθύρων σας. Αυτή η άδεια επιτρέπει στην εφαρμογή να μετακινεί και να αλλάζει μέγεθος παραθύρων για λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify needs permission to move and resize windows. No data is collected — ever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify necesita acceso de accesibilidad para gestionar tus ventanas. Este permiso permite a la app mover y redimensionar ventanas en tu nombre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify tarvitsee esteettömyysluvan ikkunoidesi hallintaan. Tämä lupa sallii sovelluksen siirtää ja muuttaa ikkunoiden kokoa puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify a besoin de l'accès d'accessibilité pour gérer vos fenêtres. Cette autorisation permet à l'app de déplacer et redimensionner les fenêtres pour vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify צריך הרשאת נגישות כדי לנהל את החלונות שלך. הרשאה זו מאפשרת לאפליקציה להזיז ולשנות גודל חלונות בשמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify को आपकी विंडो प्रबंधित करने के लिए सुलभता अनुमति की आवश्यकता है। यह अनुमति ऐप को आपकी ओर से विंडो को स्थानांतरित और आकार बदलने की अनुमति देती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify treba pristupačnost za upravljanje prozorima. Ovo dopuštenje omogućuje aplikaciji pomicanje i promjenu veličine prozora u vaše ime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Magnetify kisegítő lehetőségek engedélyét igényli az ablakok kezeléséhez. Ez az engedély lehetővé teszi, hogy az alkalmazás az Ön nevében mozgassa és méretezze az ablakokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify memerlukan akses aksesibilitas untuk mengelola jendela Anda. Izin ini memungkinkan aplikasi memindahkan dan mengubah ukuran jendela atas nama Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify ha bisogno dell'accesso all'accessibilità per gestire le finestre. Questo permesso consente all'app di spostare e ridimensionare le finestre per conto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify はウインドウを管理するためにアクセシビリティの許可が必要です。この許可により、アプリがウインドウの移動やサイズ変更を行えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify는 창을 관리하기 위해 손쉬운 사용 권한이 필요합니다. 이 권한은 앱이 사용자를 대신하여 창을 이동하고 크기를 조절할 수 있도록 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify memerlukan akses kebolehcapaian untuk mengurus tetingkap anda. Kebenaran ini membolehkan aplikasi mengalih dan mengubah saiz tetingkap bagi pihak anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify trenger tilgjengelighetstilgang for å administrere vinduene dine. Denne tillatelsen lar appen flytte og endre størrelse på vinduer på dine vegne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify heeft toegankelijkheidstoegang nodig om uw vensters te beheren. Deze machtiging stelt de app in staat om vensters namens u te verplaatsen en van grootte te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify wymaga uprawnień dostępności do zarządzania oknami. To uprawnienie pozwala aplikacji przesuwać i zmieniać rozmiar okien w Twoim imieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Magnetify precisa de acesso de acessibilidade para gerenciar suas janelas. Essa permissão permite que o app mova e redimensione janelas em seu nome."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify are nevoie de acces la accesibilitate pentru a vă gestiona ferestrele. Această permisiune permite aplicației să mute și să redimensioneze ferestrele în numele dumneavoastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify необходим доступ к Универсальному доступу для управления окнами. Это разрешение позволяет приложению перемещать и изменять размеры окон от вашего имени."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify potrebuje prístup k funkciám prístupnosti na správu vašich okien. Toto povolenie umožňuje aplikácii presúvať a meniť veľkosť okien za vás."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify behöver tillgänglighetsåtkomst för att hantera dina fönster. Denna behörighet gör det möjligt för appen att flytta och ändra storlek på fönster åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify ต้องการสิทธิ์การช่วยการเข้าถึงเพื่อจัดการหน้าต่างของคุณ สิทธิ์นี้อนุญาตให้แอปย้ายและปรับขนาดหน้าต่างแทนคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify pencerelerinizi yönetmek için erişilebilirlik erişimine ihtiyaç duyar. Bu izin, uygulamanın sizin adınıza pencereleri taşımasına ve boyutlandırmasına olanak tanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify потребує дозволу на спеціальні можливості для керування вікнами. Цей дозвіл дозволяє застосунку переміщувати та змінювати розмір вікон від вашого імені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify cần quyền trợ năng để quản lý cửa sổ của bạn. Quyền này cho phép ứng dụng di chuyển và thay đổi kích thước cửa sổ thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify 需要辅助功能权限来管理窗口。此权限允许应用代您移动和调整窗口大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify 需要輔助使用權限來管理視窗。此權限允許應用程式代您移動和調整視窗大小。"
          }
        }
      }
    },
