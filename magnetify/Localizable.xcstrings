    "settings.profiles.empty.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ تخطيط النوافذ الحالي كملف شخصي لاستعادته بسرعة لاحقًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseu la disposició actual de finestres com a perfil per restaurar-la ràpidament més tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte aktuální rozložení oken jako profil pro rychlé obnovení později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem dit nuværende vinduelayout som en profil for hurtigt at gendanne det senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie Ihr aktuelles Fensterlayout als Profil, um es später schnell wiederherzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τη διάταξη παραθύρων ως προφίλ για γρήγορη επαναφορά αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your current window layout as a profile to quickly restore it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde el diseño actual de ventanas como perfil para restaurarlo rápidamente más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna nykyinen ikkunaasettelu profiiliksi, jotta voit palauttaa sen nopeasti myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la disposition de vos fenêtres comme profil pour la restaurer rapidement plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמור את פריסת החלונות הנוכחית כפרופיל כדי לשחזר אותה במהירות מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान विंडो लेआउट को प्रोफ़ाइल के रूप में सहेजें ताकि बाद में इसे तुरंत पुनर्स्थापित किया जा सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremite trenutni raspored prozora kao profil za brzo vraćanje kasnije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentse el az aktuális ablakelrendezést profilként, hogy később gyorsan visszaállíthassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan tata letak jendela saat ini sebagai profil untuk memulihkannya dengan cepat nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il layout attuale delle finestre come profilo per ripristinarlo velocemente in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のウインドウレイアウトをプロファイルとして保存し、後ですばやく復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 창 레이아웃을 프로필로 저장하여 나중에 빠르게 복원하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan susun atur tetingkap semasa sebagai profil untuk memulihkannya dengan cepat kemudian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre det gjeldende vindusoppsettet som en profil for å gjenopprette det raskt senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla uw huidige vensterindeling op als profiel om deze later snel te herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
