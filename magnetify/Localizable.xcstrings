    "onboarding.demo.profiles.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ تخطيطات النوافذ الكاملة واستعدها بنقرة واحدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desa i restaura dissenys de finestres sencers amb un sol clic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulož a obnov celé rozvržení oken jediným kliknutím."
          }
        },
        "da" : {
          "stringUnit" : {
