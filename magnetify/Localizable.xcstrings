    "onboarding.ready.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify جاهز لمساعدتك في تنظيم مساحة عملك. ابدأ بسحب نافذة إلى حافة شاشتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify està preparat per ajudar-vos a organitzar el vostre espai de treball. Comenceu arrossegant una finestra a la vora de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify je připraven pomoci vám uspořádat pracovní prostor. Začněte přetažením okna k okraji obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify er klar til at hjælpe dig med at organisere dit arbejdsområde. Begynd med at trække et vindue til kanten af din skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify ist bereit, Ihnen bei der Organisation Ihres Arbeitsbereichs zu helfen. Ziehen Sie zunächst ein Fenster an den Bildschirmrand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Magnetify είναι έτοιμο να σας βοηθήσει να οργανώσετε τον χώρο εργασίας σας. Ξεκινήστε σύροντας ένα παράθυρο στην άκρη της οθόνης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here are some quick ways to get started:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify está listo para ayudarte a organizar tu espacio de trabajo. Empieza arrastrando una ventana al borde de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify on valmis auttamaan työtilasi järjestämisessä. Aloita vetämällä ikkuna näytön reunaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify est prêt à vous aider à organiser votre espace de travail. Commencez par glisser une fenêtre vers le bord de votre écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify מוכן לעזור לך לארגן את סביבת העבודה שלך. התחל בגרירת חלון לקצה המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify आपके कार्यक्षेत्र को व्यवस्थित करने में आपकी मदद के लिए तैयार है। एक विंडो को अपनी स्क्रीन के किनारे पर खींचकर शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify je spreman pomoći vam organizirati radni prostor. Započnite povlačenjem prozora prema rubu zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Magnetify készen áll, hogy segítsen rendezni a munkaterületét. Kezdje egy ablak húzásával a képernyő széléhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify siap membantu Anda mengatur ruang kerja. Mulai dengan menyeret jendela ke tepi layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify è pronto ad aiutarti a organizzare il tuo spazio di lavoro. Inizia trascinando una finestra sul bordo dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify はワークスペースの整理をお手伝いする準備ができました。まず、ウインドウを画面の端にドラッグしてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify가 워크스페이스를 정리할 준비가 되었습니다. 창을 화면 가장자리로 끌어서 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify sedia membantu anda menyusun ruang kerja anda. Mulakan dengan menyeret tetingkap ke tepi skrin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify er klar til å hjelpe deg med å organisere arbeidsområdet. Begynn med å dra et vindu til kanten av skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify staat klaar om u te helpen uw werkruimte te organiseren. Begin door een venster naar de rand van uw scherm te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify jest gotowy, aby pomóc Ci zorganizować przestrzeń roboczą. Zacznij od przeciągnięcia okna na krawędź ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Magnetify está pronto para ajudá-lo a organizar seu espaço de trabalho. Comece arrastando uma janela para a borda da tela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify este gata să vă ajute să vă organizați spațiul de lucru. Începeți prin a trage o fereastră la marginea ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify готов помочь вам организовать рабочее пространство. Начните с перетаскивания окна к краю экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify je pripravený pomôcť vám usporiadať pracovný priestor. Začnite potiahnutím okna k okraju obrazovky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify är redo att hjälpa dig organisera din arbetsyta. Börja med att dra ett fönster till kanten av skärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify พร้อมช่วยคุณจัดระเบียบพื้นที่ทำงานแล้ว เริ่มต้นด้วยการลากหน้าต่างไปที่ขอบหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify çalışma alanınızı düzenlemenize yardımcı olmaya hazır. Bir pencereyi ekranınızın kenarına sürükleyerek başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify готовий допомогти вам організувати робочий простір. Почніть із перетягування вікна до краю екрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify đã sẵn sàng giúp bạn sắp xếp không gian làm việc. Hãy bắt đầu bằng cách kéo một cửa sổ đến cạnh màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify 已准备好帮助您整理工作空间。先试试将窗口拖到屏幕边缘吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnetify 已準備好幫助您整理工作空間。先試試將視窗拖到螢幕邊緣吧。"
          }
        }
      }
    },
    "onboarding.ready.tip.drag.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سينجذب تلقائيًا إلى المنطقة المطابقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixarà automàticament a la zona corresponent."
          }
