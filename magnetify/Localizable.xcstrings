    "onboarding.accessibility.whyExplanation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب macOS حصول التطبيق على إذن «إمكانية الوصول» قبل أن يتمكن من نقل نوافذ التطبيقات الأخرى أو تغيير حجمها. هذه ميزة أمان من Apple. يستخدم Magnetify هذا الإذن لإدارة مواضع النوافذ فقط — وليس لأي غرض آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requereix que les apps tinguin permís d’accessibilitat abans de poder moure o canviar la mida de finestres d’altres apps. Aquesta és una funció de seguretat d’Apple. Magnetify fa servir aquest permís únicament per gestionar la posició de les finestres — per res més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vyžaduje, aby aplikace měly oprávnění „Zpřístupnění“, jinak nemohou přesouvat ani měnit velikost oken jiných aplikací. Jde o bezpečnostní prvek společnosti Apple. Magnetify používá toto oprávnění výhradně ke správě poloh oken — k ničemu jinému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kræver, at apps har tilladelse til Tilgængelighed, før de kan flytte eller ændre størrelsen på vinduer, der tilhører andre apps. Det er en sikkerhedsfunktion fra Apple. Magnetify bruger udelukkende denne tilladelse til at styre vinduespositioner — ikke til andet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS setzt voraus, dass Apps die Bedienungshilfen‑Berechtigung haben, bevor sie Fenster anderer Apps bewegen oder in der Größe ändern dürfen. Das ist eine Sicherheitsfunktion von Apple. Magnetify nutzt diese Berechtigung ausschließlich zur Verwaltung von Fensterpositionen — zu nichts anderem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS απαιτεί οι εφαρμογές να διαθέτουν δικαίωμα «Προσβασιμότητας» για να μπορούν να μετακινούν ή να αλλάζουν το μέγεθος παραθύρων άλλων εφαρμογών. Πρόκειται για χαρακτηριστικό ασφαλείας της Apple. Το Magnetify χρησιμοποιεί αυτό το δικαίωμα αποκλειστικά για τη διαχείριση της θέσης των παραθύρων — για τίποτε άλλο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requires apps to have Accessibility permission before they can move or resize windows that belong to other applications. This is an Apple security feature. Magnetify uses this permission solely to manage window positions — nothing else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS exige que las apps dispongan del permiso de Accesibilidad para poder mover o cambiar el tamaño de ventanas de otras apps. Es una función de seguridad de Apple. Magnetify utiliza este permiso únicamente para gestionar la posición de las ventanas, y para nada más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS edellyttää, että sovelluksella on Käyttöapu‑oikeus, ennen kuin se voi siirtää toisten sovellusten ikkunoita tai muuttaa niiden kokoa. Tämä on Applen turvaominaisuus. Magnetify käyttää tätä oikeutta ainoastaan ikkunoiden sijaintien hallintaan — ei mihinkään muuhun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS exige qu’une app dispose de l’autorisation Accessibilité pour pouvoir déplacer ou redimensionner les fenêtres d’autres apps. Il s’agit d’une mesure de sécurité d’Apple. Magnetify utilise cette autorisation uniquement pour gérer la position des fenêtres — rien d’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS מחייב שלאפליקציות תהיה הרשאת «נגישות» לפני שיוכלו להזיז חלונות של אפליקציות אחרות או לשנות את גודלם. זוהי תכונת אבטחה של Apple. Magnetify משתמש בהרשאה זו אך ורק לניהול מיקום החלונות — לשום מטרה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS के लिए ज़रूरी है कि कोई ऐप अन्य ऐप्स की विंडो को हिलाने या उनका आकार बदलने से पहले उसके पास ऐक्सेसिबिलिटी की अनुमति हो। यह Apple की एक सुरक्षा सुविधा है। Magnetify इस अनुमति का उपयोग केवल विंडो की स्थिति प्रबंधित करने के लिए करता है — किसी अन्य काम के लिए नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zahtijeva da aplikacije imaju dopuštenje za Pristupačnost prije nego što mogu pomicati ili mijenjati veličinu prozora drugih aplikacija. To je Appleova sigurnosna značajka. Magnetify koristi ovo dopuštenje isključivo za upravljanje položajem prozora — ni za što drugo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS előírja, hogy az alkalmazásoknak „Kisegítő lehetőségek” engedéllyel kell rendelkezniük ahhoz, hogy más alkalmazások ablakait mozgathassák vagy átméretezhessék. Ez az Apple egyik biztonsági funkciója. A Magnetify ezt az engedélyt kizárólag az ablakpozíciók kezelésére használja — semmi másra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS mengharuskan app memiliki izin Aksesibilitas agar dapat memindahkan atau mengubah ukuran jendela milik app lain. Ini merupakan fitur keamanan Apple. Magnetify hanya menggunakan izin ini untuk mengelola posisi jendela — tidak untuk keperluan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS richiede che le app abbiano l’autorizzazione Accessibilità prima di poter spostare o ridimensionare le finestre di altre app. Si tratta di una funzione di sicurezza di Apple. Magnetify utilizza questa autorizzazione unicamente per gestire la posizione delle finestre, per nient’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSでは、アプリがほかのアプリのウインドウを移動したりサイズを変更したりするには、「アクセシビリティ」の権限が必要です。これはAppleのセキュリティ機能です。Magnetifyはこの権限をウインドウの位置管理にのみ使用し、それ以外の用途には使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서는 앱이 다른 앱의 윈도우를 옮기거나 크기를 조절하려면 손쉬운 사용 권한이 필요합니다. 이는 Apple의 보안 기능입니다. Magnetify는 이 권한을 오직 윈도우 위치를 관리하는 용도로만 사용하며, 그 밖의 용도로는 사용하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS memerlukan app mempunyai kebenaran Kebolehcapaian sebelum boleh mengalihkan atau mengubah saiz tetingkap milik app lain. Ini merupakan ciri keselamatan Apple. Magnetify hanya menggunakan kebenaran ini untuk menguruskan kedudukan tetingkap — bukan untuk sebarang tujuan lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS krever at apper har tillatelse til Tilgjengelighet før de kan flytte eller endre størrelse på vinduer som tilhører andre apper. Dette er en sikkerhetsfunksjon fra Apple. Magnetify bruker denne tillatelsen utelukkende til å håndtere vindusplasseringer — ingenting annet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vereist dat apps toestemming voor Toegankelijkheid hebben voordat ze vensters van andere apps kunnen verplaatsen of de grootte ervan kunnen wijzigen. Dit is een beveiligingsfunctie van Apple. Magnetify gebruikt deze toestemming uitsluitend om vensterposities te beheren — nergens anders voor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wymaga, aby aplikacje miały uprawnienie „Dostępność”, zanim będą mogły przesuwać lub zmieniać rozmiar okien należących do innych aplikacji. To funkcja zabezpieczeń firmy Apple. Magnetify używa tego uprawnienia wyłącznie do zarządzania położeniem okien — do niczego innego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS exige que os apps tenham a permissão de Acessibilidade para poder mover ou redimensionar janelas de outros apps. Trata-se de uma função de segurança da Apple. O Magnetify usa essa permissão apenas para gerenciar a posição das janelas — para nada mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS cere ca aplicațiile să aibă permisiunea de Accesibilitate înainte de a putea muta sau redimensiona ferestrele altor aplicații. Este o funcție de securitate Apple. Magnetify folosește această permisiune exclusiv pentru a gestiona pozițiile ferestrelor — nimic altceva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS требует, чтобы у программ было разрешение «Универсальный доступ», прежде чем они смогут перемещать окна других приложений или изменять их размер. Это функция безопасности Apple. Magnetify использует это разрешение исключительно для управления положением окон — и больше ни для чего."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vyžaduje, aby aplikácie mali povolenie „Zjednodušenie prístupu“, skôr než môžu premiestňovať alebo meniť veľkosť okien iných aplikácií. Ide o bezpečnostnú funkciu spoločnosti Apple. Magnetify toto povolenie používa výhradne na správu polohy okien — na nič iné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kräver att appar har behörigheten Hjälpmedel för att kunna flytta eller ändra storlek på fönster som tillhör andra appar. Det är en säkerhetsfunktion från Apple. Magnetify använder den här behörigheten enbart för att hantera fönsterpositioner — inget annat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS กำหนดให้แอปต้องได้รับสิทธิ์ “การช่วยการเข้าถึง” ก่อน จึงจะสามารถย้ายหรือปรับขนาดหน้าต่างของแอปอื่นได้ นี่เป็นคุณสมบัติด้านความปลอดภัยของ Apple โดย Magnetify ใช้สิทธิ์นี้เพื่อจัดการตำแหน่งหน้าต่างเท่านั้น ไม่ได้ใช้เพื่อวัตถุประสงค์อื่นใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, bir uygulamanın başka uygulamalara ait pencereleri taşıyabilmesi veya yeniden boyutlandırabilmesi için Erişilebilirlik iznine sahip olmasını şart koşar. Bu, Apple’ın bir güvenlik özelliğidir. Magnetify bu izni yalnızca pencere konumlarını yönetmek için kullanır — başka hiçbir şey için değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS вимагає, щоб програми мали дозвіл «Універсальний доступ», перш ніж вони зможуть переміщати чи змінювати розмір вікон інших програм. Це функція безпеки Apple. Magnetify використовує цей дозвіл виключно для керування положенням вікон — і ні для чого іншого."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS yêu cầu ứng dụng phải có quyền Trợ năng thì mới có thể di chuyển hoặc thay đổi kích thước cửa sổ của ứng dụng khác. Đây là một tính năng bảo mật của Apple. Magnetify chỉ sử dụng quyền này để quản lý vị trí cửa sổ — không dùng cho bất kỳ mục đích nào khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上，App 必须获得「辅助功能」权限，才能移动或调整其他 App 窗口的大小。这是 Apple 的一项安全功能。Magnetify 仅将此权限用于管理窗口位置，不用于其他任何用途。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上，App 必須取得「輔助使用」權限，才能移動或調整其他 App 視窗的大小。這是 Apple 的一項安全功能。Magnetify 僅將此權限用於管理視窗位置，不會用於任何其他用途。"
          }
        }
      }
    },
