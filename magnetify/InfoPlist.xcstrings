    "NSAccessibilityUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Magnetify إلى إذن الوصول لتسهيلات الاستخدام لنقل النوافذ وتغيير حجمها نيابةً عنك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify necessita accés d'accessibilitat per moure i redimensionar finestres en nom vostre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify potřebuje přístup k usnadnění přístupu pro přesouvání a změnu velikosti oken za vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify har brug for tilgængelighedsadgang for at flytte og ændre størrelsen på vinduer på dine vegne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify benötigt Bedienungshilfen-Zugriff, um Fenster in Ihrem Auftrag zu verschieben und ihre Größe zu ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Magnetify χρειάζεται πρόσβαση προσβασιμότητας για τη μετακίνηση και αλλαγή μεγέθους παραθύρων εκ μέρους σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify needs accessibility access to move and resize windows on your behalf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify necesita acceso de accesibilidad para mover y redimensionar ventanas en tu nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify tarvitsee esteettömyysluvan voidakseen siirtää ja muuttaa ikkunoiden kokoa puolestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify a besoin de l'accès d'accessibilité pour déplacer et redimensionner les fenêtres en votre nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Magnetify זקוק להרשאות נגישות כדי להזיז ולשנות גודל של חלונות בשמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify को आपकी ओर से विंडो को स्थानांतरित और आकार बदलने के लिए एक्सेसिबिलिटी एक्सेस की आवश्यकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify treba pristup značajkama pristupačnosti za pomicanje i promjenu veličine prozora u vaše ime."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Magnetify-nak szükséges az akadálymentesítési hozzáférés az ablakok áthelyezéséhez és átméretezéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify memerlukan akses aksesibilitas untuk memindahkan dan mengubah ukuran jendela atas nama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify richiede l'accesso di accessibilità per spostare e ridimensionare le finestre per conto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify はウインドウの移動とサイズ変更を行うために、アクセシビリティへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify는 사용자를 대신하여 창을 이동하고 크기를 조절하기 위해 손쉬운 사용 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify memerlukan akses kebolehcapaian untuk mengalih dan mengubah saiz tetingkap bagi pihak anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify trenger tilgjengelighetstilgang for å flytte og endre størrelse på vinduer på dine vegne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify heeft toegankelijkheidstoegang nodig om vensters namens jou te verplaatsen en van formaat te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify potrzebuje dostępu do ułatwień dostępu, aby przenosić i zmieniać rozmiar okien w Twoim imieniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Magnetify precisa de acesso à acessibilidade para mover e redimensionar janelas em seu nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify necesită acces la funcțiile de accesibilitate pentru a muta și redimensiona ferestrele în numele dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify требуется доступ к функциям универсального доступа для перемещения и изменения размеров окон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify potrebuje prístup k funkciám prístupnosti na presúvanie a zmenu veľkosti okien vo vašom mene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify behöver åtkomst till hjälpmedel för att flytta och ändra storlek på fönster åt dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify ต้องการสิทธิ์การเข้าถึงเพื่อย้ายและปรับขนาดหน้าต่างในนามของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify, pencerelerinizi sizin adınıza taşıyıp yeniden boyutlandırabilmek için erişilebilirlik iznine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify потребує доступу до функцій доступності для переміщення та зміни розміру вікон від вашого імені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify cần quyền truy cập hỗ trợ tiếp cận để di chuyển và thay đổi kích thước cửa sổ thay cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify 需要辅助功能权限来为您移动和调整窗口大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetify 需要輔助使用權限來為您移動和調整視窗大小。"
          }
        }
      }
    },
